# Local development only. Keep actual values in your shell or an ignored .env file.
# Supply a generated password before starting resources/compose.postgres.yml.
AAII_POSTGRES_PASSWORD=
AAII_POSTGRES_DATABASE=additional_market_data
AAII_POSTGRES_USER=market_data
AAII_POSTGRES_PORT=55432
AAII_POSTGRES_BIND_HOST=127.0.0.1
# URI-encode reserved characters in a PostgreSQL password used in a DSN.
MARKET_DATA_POSTGRES_DSN=
